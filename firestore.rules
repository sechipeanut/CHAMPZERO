rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isSignedIn() { 
      return request.auth != null; 
    }

    function getUserRole() { 
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role 
        : null; 
    }

    function isAdmin() { 
      let role = getUserRole();
      return (request.auth.token != null && (request.auth.token.role == 'admin' || request.auth.token.admin == true)) ||
             role == 'admin' || role == 'Admin'; 
    }

    function isSubscriber() { 
      let role = getUserRole();
      return (request.auth.token != null && request.auth.token.role == 'subscriber') ||
             role == 'subscriber' || role == 'Subscriber'; 
    }

    function canPostListing() { 
      return isAdmin() || isSubscriber(); 
    }

    function isEmailVerified() {
      return isSignedIn() && (
        (request.auth.token.email_verified == true) ||
        (request.auth.token.firebase != null && request.auth.token.firebase.sign_in_provider == 'google.com') ||
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.emailVerified == true)
      );
    }

    // --- 1. SPECIAL RULE FOR COLLECTION GROUP QUERIES ---
    match /{path=**}/applications/{appId} {
      allow read: if isSignedIn() && resource.data.applicantId == request.auth.uid;
    }

    // --- 2. PUBLIC COLLECTIONS ---

    match /tournaments/{docId} {
      allow read: if true;
      allow create: if isEmailVerified();  // verified users or admin
      allow delete: if isAdmin() || (isSignedIn() && resource.data.createdBy == request.auth.uid);
      allow update: if isAdmin() || 
                      (isSignedIn() && (
                        resource.data.createdBy == request.auth.uid ||
                        (resource.data.coOrganizerUids != null && request.auth.uid in resource.data.coOrganizerUids) ||
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants']) ||
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['soloQueue']) ||
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'soloQueue'])
                      ));
      
      match /matchChats/{matchId} {
        allow read: if isSignedIn() && (
          isAdmin() ||
          resource == null ||
          request.auth.token.email in resource.data.authorizedCaptainEmails ||
          request.auth.token.email in resource.data.authorizedViewerEmails
        );
        allow write: if isSignedIn() && (isAdmin() || resource == null);

        match /messages/{messageId} {
          allow read: if isSignedIn() && (
            isAdmin() ||
            request.auth.token.email in get(/databases/$(database)/documents/tournaments/$(docId)/matchChats/$(matchId)).data.authorizedCaptainEmails ||
            request.auth.token.email in get(/databases/$(database)/documents/tournaments/$(docId)/matchChats/$(matchId)).data.authorizedViewerEmails
          );
          allow create: if isSignedIn() &&
            (isAdmin() || request.auth.token.email in get(/databases/$(database)/documents/tournaments/$(docId)/matchChats/$(matchId)).data.authorizedCaptainEmails) &&
            request.resource.data.senderId == request.auth.uid &&
            request.resource.data.senderName is string &&
            request.resource.data.text is string;
          allow update, delete: if isAdmin() || (isSignedIn() && resource.data.senderId == request.auth.uid);
        }
      }
      
      match /applications/{appId} {
        allow read: if isSignedIn() && (
          resource.data.registeredBy == request.auth.uid || 
          isAdmin() || 
          get(/databases/$(database)/documents/tournaments/$(docId)).data.createdBy == request.auth.uid
        );
        allow create: if isEmailVerified() && request.resource.data.registeredBy == request.auth.uid;
        allow update: if isSignedIn() && (
          (
            resource.data.registeredBy == request.auth.uid &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminNotes']) &&
            (
              // Either not touching status at all...
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
              // ...or only allowed to set it to 'pending_update' (edit request)
              request.resource.data.status == 'pending_update'
            )
          ) ||
          isAdmin() ||
          get(/databases/$(database)/documents/tournaments/$(docId)).data.createdBy == request.auth.uid
        );
        allow delete: if isSignedIn() && (resource.data.registeredBy == request.auth.uid || isAdmin());
      }
    }

    match /events/{docId} {
      allow read: if true;
      allow write: if isAdmin();
  
      match /chat/{messageId} {
        allow read: if true;
        allow create: if isSignedIn() && 
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.message is string &&
                       request.resource.data.message.size() > 0 &&
                       request.resource.data.message.size() <= 200 &&
                       request.resource.data.username is string &&
                       request.resource.data.timestamp != null;
        allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
        allow delete: if isAdmin();
      }
    }

    match /careers/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /talents/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        resource.data.targetUserId == request.auth.uid || 
        resource.data.isGlobal == true ||
        isAdmin()
      );
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.targetUserId != null &&
        request.resource.data.isGlobal != true
      );
      allow update, delete: if isAdmin();
    }
    
    match /specific-notifications/{notificationId} {
      allow read: if isSignedIn() && (
        resource.data.targetUserId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.targetUserId != null &&
        request.resource.data.isGlobal != true &&
        request.resource.data.tournamentId != null && (
          isAdmin() ||
          get(/databases/$(database)/documents/tournaments/$(request.resource.data.tournamentId)).data.createdBy == request.auth.uid
        )
      );
      allow update, delete: if isAdmin();
    }

    // --- 3. RECRUITMENT & TEAMS ---

    match /recruitment/{teamId} {
      allow read: if true;
      
      allow create: if isEmailVerified() && (
        request.resource.data.type == 'lft' || 
        request.resource.data.type == 'team' || 
        canPostListing()
      );
      
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.authorId || 
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'currentMembers', 'lastActive'])
      );
      
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.authorId || isAdmin());

      match /applications/{applicationId} {
        allow read: if isSignedIn();

        allow create: if isSignedIn();
        
        allow update: if isSignedIn() && (
          request.auth.uid == get(/databases/$(database)/documents/recruitment/$(teamId)).data.authorId ||
          isAdmin() || 
          exists(/databases/$(database)/documents/recruitment/$(teamId))
        );

        allow delete: if isSignedIn() && (
          request.auth.uid == resource.data.applicantId ||
          request.auth.uid == get(/databases/$(database)/documents/recruitment/$(teamId)).data.authorId ||
          isAdmin()
        );
      }
      
      match /messages/{msgId} {
        allow read, write: if isSignedIn();
      }

      match /private_chats/{participantId} {
        allow read: if isSignedIn() && (request.auth.uid == participantId || request.auth.uid == get(/databases/$(database)/documents/recruitment/$(teamId)).data.authorId || isAdmin());
        allow write: if isSignedIn();

        match /messages/{msgId} {
          allow read, write: if isSignedIn() && (
            request.auth.uid == participantId || 
            request.auth.uid == get(/databases/$(database)/documents/recruitment/$(teamId)).data.authorId || 
            isAdmin()
          );
        }
      }
    }
    
    // --- 3.1 DAILY LFG & SCRIM MATCHMAKING BOARD ---
    match /scrims/{scrimId} {
      // Allow read on /scrims for all authenticated and unauthenticated users
      allow read: if true;

      // Allow create if user is logged in, email is verified, and is the captain
      allow create: if isEmailVerified() && request.resource.data.captainId == request.auth.uid;

      // Allow update if:
      // - Creator modifies or cancels their scrim (captainId == request.auth.uid)
      // - Authenticated opponent accepts an open scrim (cannot be the host captain)
      // - Admin override
      allow update: if isSignedIn() && (
        (resource.data.captainId == request.auth.uid) ||
        (
          resource.data.status == 'open' && 
          request.resource.data.status == 'accepted' && 
          request.resource.data.opponentCaptainId == request.auth.uid &&
          resource.data.captainId != request.auth.uid
        ) ||
        (
          resource.data.opponentCaptainId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'opponentContact', 'opponentTeamName'])
        ) ||
        isAdmin()
      );

      // Allow delete if captain or admin
      allow delete: if isSignedIn() && (resource.data.captainId == request.auth.uid || isAdmin());
    }
    
    // --- 4. USER DATA & PRESENCE ---

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && (
        !request.resource.data.keys().hasAny(['role']) ||
        request.resource.data.role == 'user'
      );
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
      );
      allow delete: if isAdmin();

      match /invites/{teamId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        // Prevent self-invitation at the database level
        allow create: if isSignedIn() && request.auth.uid != userId && request.resource.data.invitedBy == request.auth.uid;
        allow update, delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }

      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // --- 5. SOCIAL HUB: FRIEND REQUESTS & GLOBAL COMMUNITY CHAT ---

    match /friend_requests/{requestId} {
      allow read: if isSignedIn();
      // Prevent sending friend requests to oneself and require verified email
      allow create: if isEmailVerified() && 
                    request.resource.data.fromUid == request.auth.uid && 
                    request.resource.data.toUid != request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.toUid == request.auth.uid || 
        resource.data.fromUid == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.toUid == request.auth.uid || 
        resource.data.fromUid == request.auth.uid || 
        isAdmin()
      );
    }

    match /global_chat_messages/{messageId} {
      allow read: if true;
      allow create: if isEmailVerified() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.senderId == request.auth.uid);
    }

    match /global_chat/{messageId} {
      allow read: if true;
      allow create: if isEmailVerified();
      allow update, delete: if isAdmin() || isSignedIn();
    }

    // --- 6. TOURNAMENT REGISTRATIONS, CLAIMS & PAYOUTS ---

    match /registrations/{regId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.registeredBy == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.registeredBy == request.auth.uid || isAdmin());
    }

    match /tournament_registrations/{regId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.registeredBy == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.registeredBy == request.auth.uid || isAdmin());
    }

    match /payout_claims/{claimId} {
      allow read: if isSignedIn() && (
        resource.data.claimedBy == request.auth.uid ||
        resource.data.organizerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.claimedBy == request.auth.uid;
      allow update: if isSignedIn() && (
        (resource.data.claimedBy == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes', 'contact', 'accountNumber', 'accountName', 'channel'])) ||
        (resource.data.organizerId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'disbursedAt', 'disburseRefNumber', 'disbursedBy', 'disburseNotes'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // --- 7. FINANCIAL TRANSACTIONS (CASHINS & WITHDRAWALS) ---

    match /cashins/{cashinId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.uid == request.auth.uid ||
        resource.data.organizerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.uid == request.auth.uid ||
        request.resource.data.organizerId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    match /withdrawals/{withdrawalId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.uid == request.auth.uid ||
        resource.data.organizerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.uid == request.auth.uid ||
        request.resource.data.organizerId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // --- 8. GLOBAL CONTACT MESSAGES ---
    
    match /messages/{docId} {
      allow create: if true;
      allow read, delete, update: if isAdmin();
    }

    // --- 9. SITE CONFIGURATION (STATS & SETTINGS) ---
    
    match /site_config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system_config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system_settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /donations/{document=**} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // --- 10. SHOP SYSTEM ---
    
    match /products/{productId} {
      allow read: if true;      
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
    }

    // --- 11. DIRECT MESSAGES ---
    match /direct_messages/{dmId} {
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.participants || isAdmin()
      );
      allow create: if isEmailVerified() && (
        request.auth.uid in request.resource.data.participants
      );
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.participants || isAdmin()
      );

      match /messages/{msgId} {
        allow read: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/direct_messages/$(dmId)).data.participants || isAdmin()
        );
        allow create: if isEmailVerified() && (
          request.auth.uid in get(/databases/$(database)/documents/direct_messages/$(dmId)).data.participants &&
          (request.resource.data.senderId == request.auth.uid || request.resource.data.senderUid == request.auth.uid)
        );
        allow update, delete: if isAdmin();
      }
    }

    // --- 12. REWARDS & REDEMPTIONS ---
    match /rewards_redemptions/{redemptionId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // --- 13. SITE CONFIGURATION & CATALOGS ---
    match /site_config/{configId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
