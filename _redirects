# ==============================================================================
# Netlify Redirects & Security Access Control for ChampZero
# ==============================================================================

# 1. HARDENED SECURITY & SOURCE ISOLATION (Forced 404 on sensitive paths)
/.env*                  /404.html             404!
/.git*                  /404.html             404!
/server.js              /404.html             404!
/firestore.rules        /404.html             404!
/*.json                 /404.html             404!
/*.toml                 /404.html             404!
/*.md                   /404.html             404!
/scratch/*              /404.html             404!
/scripts/*              /404.html             404!
/netlify/*              /404.html             404!
/.netlify/functions/firebase-config /404.html 404!
/api/firebase-config    /404.html             404!
/ARCHITECTURE.txt       /404.html             404!
/deno.lock              /404.html             404!

# 2. SERVERLESS API PROXY ROUTES
/api/*                  /.netlify/functions/:splat           200

